{
  "name": "react-template",
  "version": "2.1.11",
  "private": true,
  "homepage": "https://will-molloy.github.io/react-template/",
  "license": "GPL-2.0",
  "repository": "github:will-molloy/react-template",
  "scripts": {
    "build": "tsc -b && vite build",
    "deploy": "gh-pages -d dist",
    "dev": "vite",
    "format": "oxfmt \"**/*.{js,ts,tsx,css}\" package.json",
    "preinstall": "npx only-allow pnpm",
    "lint": "oxlint --deny-warnings",
    "lint:css": "stylelint \"src/**/*.{css,scss}\"",
    "preview": "vite preview",
    "test": "vitest",
    "test:coverage": "vitest run --coverage",
    "verify:all": "concurrently --names \"format,lint,lint-css,test,build\" --prefix-colors \"blue,green,yellow,magenta,cyan\" \"pnpm format --check\" \"pnpm lint\" \"pnpm lint:css\" \"pnpm test:coverage\" \"pnpm build\""
  },
  "dependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^8.0.0",
    "@testing-library/react": "^16.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react-swc": "^4.0.0",
    "@vitest/coverage-v8": "^5.0.0",
    "concurrently": "^10.0.0",
    "gh-pages": "^6.1.1",
    "jsdom": "^31.0.0",
    "oxfmt": "^0.80.0",
    "oxlint": "^1.95.0",
    "oxlint-tsgolint": "^7.0.2008",
    "stylelint": "^18.0.0",
    "stylelint-config-standard": "^41.0.0",
    "typescript": "^7.0.0",
    "vite": "^8.0.0",
    "vitest": "^5.0.0"
  }
}
